# Generates a C++ source embedding a .nnue file as a byte array.
# Usage: cmake -DNET_FILE=<path> -DOUT_FILE=<path> -P embed_net.cmake
# A missing NET_FILE yields an empty net (the engine then falls back to the HCE).
set(_name "")
set(_size 0)
set(_bytes "0")
if(NET_FILE AND EXISTS "${NET_FILE}")
    file(READ "${NET_FILE}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # Line breaks every 32 bytes keep the generated file readable for compilers/editors.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" _bytes "${_bytes}")
    get_filename_component(_name "${NET_FILE}" NAME)
endif()
set(_content "// Generated by cmake/embed_net.cmake - do not edit.
#include <cstddef>
namespace engine {
namespace nnue {
namespace embedded {
extern const unsigned char data[];
extern const size_t size;
extern const char name[];
alignas(64) const unsigned char data[] = {
${_bytes}
};
const size_t size = ${_size};
const char name[] = \"${_name}\";
} // namespace embedded
} // namespace nnue
} // namespace engine
")
# Only rewrite when the content changes (avoids needless recompiles).
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" _old)
    if(_old STREQUAL _content)
        return()
    endif()
endif()
file(WRITE "${OUT_FILE}" "${_content}")
